// Jukebox LIVE on Cloudflare (docs/08-cloudflare-port.md, step 5.2).
//
//   cd jukebox/worker
//   uvx --from workers-py@1.17.9 pywrangler dev       local, on port 8787
//   uvx --from workers-py@1.17.9 pywrangler deploy    Filip's account
{
  "name": "jukebox-live",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],

  // Copies ../app into src/app and its static files into public/static.
  // `dev` reloads when ../app changes; after editing src/entry.py, restart it.
  "build": { "command": "python3 build.py", "watch_dir": "../app" },

  // render.py hashes app.css and app.js for the cache-buster, so they travel
  // with the code as text as well as being served from the assets.
  "rules": [{ "type": "Text", "globs": ["app/static/*"], "fallthrough": true }],

  // /static/* is answered from here without starting the Worker.
  "assets": { "directory": "public" },

  // The whole app runs in one object, "jukebox", with its SQLite database.
  "durable_objects": {
    "bindings": [{ "name": "JUKEBOX", "class_name": "Jukebox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jukebox"] }],

  // Two secrets, set with `pywrangler secret put <NAME>`: JUKEBOX_SECRET_KEY,
  // and JUKEBOX_SETUP_TOKEN for the first account (/admin/setup).
  "vars": {
    // Where the object and its database live. Fixed at the first deploy.
    "JUKEBOX_JURISDICTION": "eu"
    // At the switch (docs/08, step 9.1), and not before, add
    //   "JUKEBOX_PUBLIC_URL": "https://hlasuj.jukeboxheroes.cz"
    // Until then QR codes and Share links use the address the console was
    // opened on, which is the one that works.
  },

  // Also at the switch, once jukeboxheroes.cz is a zone on this account:
  // "routes": [{ "pattern": "hlasuj.jukeboxheroes.cz", "custom_domain": true }],

  "observability": { "enabled": true }
}
