# Copy to .dev.vars for `pywrangler dev`. Never used on Cloudflare, where the
# secret is set with `wrangler secret put JUKEBOX_SECRET_KEY`.
JUKEBOX_DEV=1
JUKEBOX_SECRET_KEY=local-development-only-not-a-secret
JUKEBOX_PUBLIC_URL=
# The local runtime does not implement jurisdictions.
JUKEBOX_JURISDICTION=
